__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.venv/
venv/

# Python build / packaging artifacts
*.egg-info/
build/
dist/

# Numba JIT cache
*.nbc
*.nbi

# Cached figure data (machine-specific timings; regenerated by benchmark scripts)
benchmarks/figdata_*.csv

# Coalescent LD library + on-disk LD cache sidecars (large, regenerated locally)
ld_library.npz
*.npz.dat.npy

# Benchmark msprime pool cache (regenerated on demand; keyed by #SNPs)
benchmarks/.ld_cache/
# Bivariate rg benchmark population-LD cache (regenerated on demand)
benchmarks/.rg_cache/

# External-tool benchmark environments and work dir (local-only; see
# benchmarks/README.md "External tools" section)
benchmarks/.venv-ldsc/
benchmarks/.mixer/
benchmarks/.ext_work/

# LaTeX build artifacts from studies/*/REPORT.tex (the PDF itself is committed)
studies/*/*.aux
studies/*/*.log
studies/*/*.out
studies/*/*.toc

# Local benchmark-run scaffolding and logs (not deliverables). The CSV and
# sidecar patterns are broad on purpose: the real-data benchmarks refuse to run
# on a dirty tree, so an exploratory run that left an untracked
# benchmarks/_whatever.csv behind would block the next one.
benchmarks/_*.log
benchmarks/_*.stdout
benchmarks/_run_all.sh
benchmarks/_*.csv
benchmarks/_*.provenance.json
